generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String     @id
  username   String
  globalName String?
  avatar     String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  auditLogs  AuditLog[]
  panels     Panel[]
}

model Guild {
  id              String            @id
  name            String
  icon            String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  settings        GuildSettings?
  panels          Panel[]
  stickers        Sticker[]
  warnings        Warning[]
  takoIntegration TakoIntegration?
  takoDonations   TakoDonation[]
  takoRewardTiers TakoRewardTier[]
  embedTemplates  EmbedTemplate[]
  userNotes       UserNote[]
  voiceSessions   VoiceSession[]
  plugins         GuildPlugin[]
  entitlements    GuildEntitlement[]
  pluginCredentials GuildPluginCredential[]
  commandSync     GuildCommandSync?
}

model GuildSettings {
  guildId                String   @id
  logChannelId           String?
  messageDeleteLogChannelId String?
  defaultStyle           String   @default("PREMIUM")
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  stickerEnabled         Boolean  @default(false)
  slowmodeChannels       String[] @default([])
  slowmodeEnabled        Boolean  @default(false)
  slowmodeIntervalBusy   Int      @default(10)
  slowmodeIntervalQuiet  Int      @default(0)
  slowmodeIntervalNormal Int      @default(5)
  anomalyEnabled              Boolean  @default(false)
  phishingDetectionEnabled    Boolean  @default(true)
  contentAnomalyEnabled       Boolean  @default(true)
  userAnomalyEnabled          Boolean  @default(true)
  guildBaselineEnabled        Boolean  @default(true)
  anomalyEnforcementMode      String   @default("AUDIT_ONLY")

  // New Moderation Settings
  warnLimitEnabled       Boolean  @default(false)
  warnLimitThreshold     Int      @default(3)
  warnTimeoutDurationMin Int      @default(60)
  warnExpiryDays         Int      @default(30) // 0 = Never Expire

  guild                  Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model Panel {
  id              String      @id @default(cuid())
  guildId         String
  createdById     String
  channelId       String?
  messageId       String?
  name            String
  title           String
  accentText      String?
  description     String?
  type            PanelType   @default(SELF_ROLE)
  mode            PanelMode   @default(BUTTONS)
  style           PanelStyle  @default(PREMIUM)
  color           String      @default("#5865F2")
  imageUrl        String?
  thumbnailUrl    String?
  maxRoles        Int         @default(0)
  requireRoleId   String?
  status          PanelStatus @default(DRAFT)
  lastPublishedAt DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  auditLogs       AuditLog[]
  createdBy       User        @relation(fields: [createdById], references: [id])
  guild           Guild       @relation(fields: [guildId], references: [id], onDelete: Cascade)
  roles           PanelRole[]
  logs            RoleLog[]
}

model PanelRole {
  id          String      @id @default(cuid())
  panelId     String
  roleId      String
  emoji       String?
  label       String
  description String?
  buttonStyle ButtonStyle @default(SECONDARY)
  position    Int
  panel       Panel       @relation(fields: [panelId], references: [id], onDelete: Cascade)

  @@unique([panelId, roleId])
}

model RoleLog {
  id        String     @id @default(cuid())
  guildId   String
  userId    String
  roleId    String
  action    RoleAction
  panelId   String?
  createdAt DateTime   @default(now())
  panel     Panel?     @relation(fields: [panelId], references: [id])
}

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  panelId   String?
  action    String
  metadata  Json?
  createdAt DateTime @default(now())
  panel     Panel?   @relation(fields: [panelId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
}

model Sticker {
  id        String   @id @default(cuid())
  guildId   String
  name      String
  url       String
  type      String
  createdAt DateTime @default(now())
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, name])
}

model Session {
  id        String   @id @default(cuid())
  sid       String   @unique
  data      String
  expiresAt DateTime
}

enum PanelType {
  SELF_ROLE
  RULES
  ANNOUNCEMENT
  LEADERBOARD
}

enum PanelMode {
  BUTTONS
  MENU
}

enum PanelStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PanelStyle {
  PREMIUM
  MINIMAL
  COLORFUL
  NEON
}

enum ButtonStyle {
  PRIMARY
  SECONDARY
  SUCCESS
  DANGER
}

enum RoleAction {
  ADD
  REMOVE
}

model Warning {
  id          String    @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  reason      String
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  guild       Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
}

model BoosterRoleClaimToken {
  token     String   @id
  guildId   String
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([guildId, userId])
}

model BoosterCustomRole {
  id             String    @id @default(cuid())
  guildId        String
  userId         String
  roleId         String    @unique
  name           String
  color          String
  primaryColor   String    @default("#ffffff")
  secondaryColor String?
  tertiaryColor  String?
  iconUrl        String?
  active         Boolean   @default(true)
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([guildId, userId])
}

model TakoIntegration {
  guildId        String   @id
  enabled        Boolean  @default(false)
  creatorSlug    String?
  apiKey         String?
  webhookToken   String?
  rewardRoleId   String?
  minimumAmount  Int      @default(10000)
  paymentMethods String[] @default(["qris"])
  logChannelId   String?
  directNotificationsEnabled Boolean @default(true)
  directNotificationChannelId String?
  directNotifyMinimumAmount Int @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  guild          Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
}

model TakoDonation {
  id             String    @id @default(cuid())
  guildId        String
  discordUserId  String
  transactionId  String?   @unique
  amount         Int
  paymentMethod  String
  senderName     String
  email          String
  message        String?
  status         String    @default("PENDING") // PENDING, PAID, ROLE_ASSIGNED, FAILED, IGNORED
  failureReason  String?
  roleAssignedAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  guild          Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([discordUserId])
  @@index([status])
}

model TakoRewardTier {
  id              String   @id @default(cuid())
  guildId         String
  label           String
  thresholdAmount Int
  roleId          String
  position        Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  guild           Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@unique([guildId, thresholdAmount])
}

model EmbedTemplate {
  id        String   @id @default(cuid())
  guildId   String
  category  String
  name      String
  template  Json
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, category])
  @@index([guildId])
}

model DiscordAgentSettings {
  guildId              String   @id
  enabled              Boolean  @default(false)
  provider             String   @default("gemini")
  model                String   @default("gemini-2.5-flash")
  allowedUserIds       String[] @default([])
  allowedChannelIds    String[] @default([])
  excludedChannelIds   String[] @default([])
  systemPrompt         String?
  messageRetentionDays Int      @default(30)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model AgentInteractionLog {
  id           String   @id @default(cuid())
  guildId      String
  channelId    String
  userId       String
  targetUserId String?
  prompt       String
  response     String?
  status       String
  error        String?
  createdAt    DateTime @default(now())

  // Token usage fields
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  totalTokens      Int      @default(0)

  @@index([guildId, createdAt])
  @@index([guildId, userId, createdAt])
  @@index([guildId, targetUserId, createdAt])
}

model DiscordMessageLog {
  id          String    @id
  guildId     String
  channelId   String
  authorId    String
  content     String
  attachments Json?
  embeds      Json?
  createdAt   DateTime
  editedAt    DateTime?
  deletedAt   DateTime?

  @@index([guildId, authorId, createdAt])
  @@index([guildId, channelId, createdAt])
  @@index([guildId, createdAt])
}

model AgentActionProposal {
  id            String   @id @default(cuid())
  guildId       String
  channelId     String
  requestedById String
  targetUserId  String?
  actionType    String
  payload       Json
  status        String   @default("PENDING")
  expiresAt     DateTime
  executedAt    DateTime?
  error         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([guildId, requestedById, status])
  @@index([guildId, targetUserId, createdAt])
}

model UserNote {
  id          String   @id @default(cuid())
  guildId     String
  userId      String
  moderatorId String
  content     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
}

model VoiceSession {
  id        String    @id @default(cuid())
  guildId   String
  userId    String
  channelId String
  joinedAt  DateTime
  leftAt    DateTime?
  duration  Int?      // Duration in seconds
  createdAt DateTime  @default(now())

  guild     Guild     @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId])
  @@index([userId])
  @@index([joinedAt])
}

enum PluginType {
  FREE
  PREMIUM
}

enum GuildPluginStatus {
  INSTALLED
  DISABLED
  SUSPENDED
  UNAVAILABLE
}

enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
  PENDING
}

model PluginCatalog {
  id           String     @id
  version      String
  name         String
  description  String
  type         PluginType @default(FREE)
  price        Int?
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  guilds       GuildPlugin[]
  entitlements GuildEntitlement[]
  credentials  GuildPluginCredential[]

  @@index([active])
}

model GuildPlugin {
  guildId     String
  pluginId    String
  status      GuildPluginStatus @default(INSTALLED)
  settings    Json?
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
  guild       Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plugin      PluginCatalog @relation(fields: [pluginId], references: [id], onDelete: Restrict)

  @@id([guildId, pluginId])
  @@index([pluginId, status])
}

model GuildEntitlement {
  id         String @id @default(cuid())
  guildId    String
  pluginId   String
  provider   String
  externalId String?
  status     EntitlementStatus @default(PENDING)
  startsAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  guild      Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plugin     PluginCatalog @relation(fields: [pluginId], references: [id], onDelete: Restrict)

  @@index([guildId, pluginId, status])
  @@unique([provider, externalId])
}

model GuildPluginCredential {
  id             String   @id @default(cuid())
  guildId        String
  pluginId       String
  encryptedToken String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  guild          Guild         @relation(fields: [guildId], references: [id], onDelete: Cascade)
  plugin         PluginCatalog @relation(fields: [pluginId], references: [id], onDelete: Cascade)

  @@unique([guildId, pluginId])
  @@index([pluginId])
}

model GuildCommandSync {
  guildId      String @id
  manifestHash String
  syncedAt     DateTime?
  lastError    String?
  updatedAt    DateTime @updatedAt
  guild        Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)
}